{
  "name": "jobai-backend",
  "version": "1.0.0",
  "description": "AI-powered job automation platform backend",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node tests/api.test.js",
    "setup": "node src/database/setup.js",
    "db:check": "node src/database/setup.js --check",
    "db:backup": "node src/database/setup.js --backup",
    "db:maintain": "node src/database/setup.js --maintain",
    "db:migrate": "node src/database/migrate.js --run",
    "db:status": "node src/database/migrate.js",
    "install:browsers": "npx playwright install chromium",
    "cleanup": "node -e \"const fs=require('fs'),path=require('path'),dir=path.join(__dirname,'uploads/tailored');if(fs.existsSync(dir)){const files=fs.readdirSync(dir);const old=files.filter(f=>{const s=fs.statSync(path.join(dir,f));return Date.now()-s.mtimeMs>7*24*60*60*1000;});old.forEach(f=>fs.unlinkSync(path.join(dir,f)));console.log('Cleaned',old.length,'files');}\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.15.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.7.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "playwright": "^1.44.0",
    "uuid": "^9.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
