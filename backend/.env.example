# ═══════════════════════════════════════════════════════════════════════════════
# JobAI Backend — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in all REQUIRED values before starting.
# Generate secrets with: openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
# At least 32 random hex chars. Changing this invalidates all existing sessions.
JWT_SECRET=CHANGE_THIS_run_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# ── AI (REQUIRED) ─────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-CHANGE_THIS

# ── Database ──────────────────────────────────────────────────────────────────
# Production (Docker volume):   /app/data/jobai.db
# Bare-metal / PM2:             /var/lib/jobai/jobai.db  (or any writable path)
# The directory is created automatically if it does not exist.
DB_PATH=/app/data/jobai.db

# ── Frontend origin (CORS) ────────────────────────────────────────────────────
# Set to your public domain. No trailing slash.
FRONTEND_URL=https://yourdomain.com

# ── Email / SMTP (Required for email features) ────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your.gmail@gmail.com
# Gmail: generate a 16-char App Password at myaccount.google.com/apppasswords
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=JobAI <your.gmail@gmail.com>

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_USERS=15
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
