# ═══════════════════════════════════════════════════════════════════
# JobAI Backend — Mode 4: PRODUCTION (separated, different servers)
# ═══════════════════════════════════════════════════════════════════
#
# Use when frontend and backend are on DIFFERENT hosts/services.
# Example: backend on Render/Railway, frontend on Vercel/Netlify.
#
# The only difference from .env.production is FRONTEND_URL points
# to a different domain than where the backend lives.
#
# Copy to .env on your backend server/service:
#   cp backend/.env.separated backend/.env
#
# ═══════════════════════════════════════════════════════════════════

PORT=5000
NODE_ENV=production

# ── Required ──────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32_output
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# ── Database ──────────────────────────────────────────────────────
DB_PATH=/app/data/jobai.db

# ── CORS ──────────────────────────────────────────────────────────
# Mode 4 (separated): frontend lives on a DIFFERENT domain/subdomain.
# This is what changes vs .env.production.
FRONTEND_URL=https://app.yourdomain.com

# Multiple origins? Comma-separate them:
# FRONTEND_URL=https://app.yourdomain.com,https://staging.yourdomain.com

# ── Email ─────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your.gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=JobAI <your.gmail@gmail.com>

# ── Limits ────────────────────────────────────────────────────────
MAX_USERS=15
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
