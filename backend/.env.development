# ═══════════════════════════════════════════════════════════════════════════════
# JobAI Backend — DEVELOPMENT Environment (.env)
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env:  cp .env.development .env
# Then fill in ANTHROPIC_API_KEY and (optionally) email settings.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Security ──────────────────────────────────────────────────────────────────
# OK for dev — MUST change for production (openssl rand -hex 32)
JWT_SECRET=dev_secret_change_in_production_32chars_minimum

# ── AI (REQUIRED for AI features) ────────────────────────────────────────────
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── Database ──────────────────────────────────────────────────────────────────
# Relative to backend/ — stored in the repo root's data/ folder
DB_PATH=./jobai.db

# ── Frontend origin (CORS) ────────────────────────────────────────────────────
# Vite dev server. Comma-separate multiple origins if needed.
FRONTEND_URL=http://localhost:5173

# ── Email / SMTP (Optional — required for cold email features) ────────────────
# Gmail setup: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your.gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=JobAI <your.gmail@gmail.com>

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_USERS=15
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
