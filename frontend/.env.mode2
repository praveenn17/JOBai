# ═══════════════════════════════════════════════════════════════════
# JobAI Frontend — Mode 2: SEPARATED (local, different ports)
# ═══════════════════════════════════════════════════════════════════
#
# Frontend on :5173, backend on :5000. Axios calls go directly to
# the backend (no Vite proxy involved).
#
# Copy to .env:  cp frontend/.env.mode2 frontend/.env
# Then restart:  npm run dev
# ═══════════════════════════════════════════════════════════════════

VITE_API_URL=http://localhost:5000/api
