# ═══════════════════════════════════════════════════════════════════
# JobAI Frontend — Mode 3: TOGETHER (production, same domain)
# ═══════════════════════════════════════════════════════════════════
#
# Nginx serves the React build AND proxies /api to the backend.
# Frontend uses relative /api URLs — no domain needed.
#
# Build:  cp frontend/.env.mode3 frontend/.env.production
#         npm run build
# ═══════════════════════════════════════════════════════════════════

# Empty = relative /api paths. Nginx handles the proxy.
VITE_API_URL=
