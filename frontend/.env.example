# ══════════════════════════════════════════════════
# JobAI Frontend — Environment Variables
# ══════════════════════════════════════════════════
# Copy to .env (dev) or .env.production (prod) and
# fill in values before running `npm run build`.
# ══════════════════════════════════════════════════

# ── API URL ──────────────────────────────────────
# DEVELOPMENT (default):
#   Leave blank — Vite proxy handles /api → http://localhost:5000
#   (configured in vite.config.js)
#
# PRODUCTION:
#   Set to your backend's public URL.
#   Must include /api suffix. No trailing slash.
VITE_API_URL=https://yourbackend.com/api

# ── App Name (optional) ──────────────────────────
VITE_APP_NAME=JobAI
